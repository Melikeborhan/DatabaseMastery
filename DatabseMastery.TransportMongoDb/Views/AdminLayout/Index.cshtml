
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")


<!-- body start -->
<body data-menu-color="light" data-sidebar="default">

        <!-- Begin page -->
        <div id="app-layout">


            <!-- Topbar Start -->
		@await Component.InvokeAsync("_AdminLayoutTopBarComponentPartial")
            
		@await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")


        <div class="content-page">
            <div class="content">

                <!-- Start Content-->
                <div class="container-fluid">

                    @RenderBody()

                </div> <!-- container-fluid -->
            </div> <!-- content -->
            <!-- Footer Start -->
       
            <!-- end Footer -->

        </div>

           
        </div>
    @await Component.InvokeAsync("_AdminLayoutScriptsComponentPartial")
   
	@await RenderSectionAsync("Scripts", required: false) //kýsaca bu kýsým sayfaya özel scriptler eklemek istediðimizde kullanacaðýmýz alaný oluþturuyoruz. Eðer bu alaný oluþturmazsak sayfaya özel scriptler ekleyemeyiz.
    </body>
</html>
