@model List<ResultHowItWorksDto>

<section class="section pt-85 bg-worldmap">
    <div class="container">
        <div class="text-center">
            <img class="mb-15" src="/templates/assets/imgs/template/icons/favicon.svg" alt="transp">
            <h2 class="color-brand-2 mb-20">Nasıl Çalışıyoruz?</h2>
            <p class="font-md color-grey-700">Teslimat yapmak istediğiniz şehirleri siz seçersiniz. Tüm teslimatlar belirli bir hizmet alanı dahilinde gerçekleştirilir ve teslimat hizmetleri konuma göre farklılık gösterir. Mod veya gereksinim ne olursa olsun, zamanında teslim sağlamak için ideal ekspres kargo çözümünü bulup rezerve edeceğiz.</p>
        </div>
        <div class="row mt-50">
            <div class="col-lg-6 mb-30">
                <div class="box-image-how">
                    <img class="w-100" src="/templates/assets/imgs/page/homepage1/how-it-work.png" alt="transp">
                    <div class="box-info-bottom-img">
                        <div class="image-play"><img class="mb-15" src="/templates/assets/imgs/template/icons/play.svg" alt="transp"></div>
                        <div class="info-play">
                            <h4 class="color-white mb-15">Bu alanda 25 yıllık deneyime sahibiz</h4>
                            <p class="font-sm color-white">Yılların verdiği tecrübe ve güvenilirlikle, her teslimatı özenle tamamlıyor ve müşterilerimizin memnuniyetini her zaman ön planda tutuyoruz.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-30">
                <ul class="list-how-works">
                    @foreach(var item in Model){
                        <li>
                            <div class="image-how"> <span class="img"> <img src="@item.IconUrl" alt="transp"></span></div>
                            <div class="info-how">
                                <h5 class="color-brand-2">@item.Title</h5>
                                <p class="font-md color-grey-700">@item.Description</p>
                            </div>
                        </li>
                    }
                    
                    
                </ul>
            </div>
        </div>
    </div>
</section>